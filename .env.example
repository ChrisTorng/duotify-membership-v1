# Duotify Membership API - 環境變數範例
# 複製此檔案為 .env 並填入真實值 (不要提交 .env 到 Git)

# SendGrid 設定
SENDGRID_API_KEY=SG.your_actual_sendgrid_api_key_here

# 資料庫連線
DB_SERVER=localhost
DB_DATABASE=DuotifyMembership
DB_USER=sa
DB_PASSWORD=YourStrong@Password

# 應用程式設定
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# 安全性注意事項:
# 1. 永遠不要將真實的 API Key 或密碼提交到版本控制
# 2. 使用 dotnet user-secrets 來管理開發環境的敏感資訊
# 3. 生產環境使用 Azure Key Vault 或類似的密鑰管理服務
# 4. 定期輪換 API Key 和密碼
